# Copy this file to .env and fill in your real values.
# Get keys from https://dashboard.stripe.com/test/apikeys

# Secret key — starts with sk_test_... Never expose this in frontend code.
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Publishable key — starts with pk_test_... safe to use in the browser.
STRIPE_PUBLISHABLE_KEY=pk_test_51U57YoLoGIskmksfiHpiLkNbmz8VWpPlKi0dFoOKLH3fiCIN3ESboAIRdqoefQo5yj4nKJd9n4ZnbrEatb0lnydn00ixGDuPRq

# The connected account id for the creator receiving funds.
# Create one via Stripe Connect onboarding — looks like acct_xxx.
CREATOR_ACCOUNT_ID=acct_REPLACE_ME

# Optional: webhook signing secret from `stripe listen`
STRIPE_WEBHOOK_SECRET=

# Optional: override if not running on localhost:4242
DOMAIN=http://localhost:4242
